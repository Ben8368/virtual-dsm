-nodefaults -machine type=q35,smm=off,usb=off,vmport=off,dump-guest-core=off,hpet=off,accel=kvm -enable-kvm -global kvm-pit.lost_tick_policy=discard -cpu host -smp 2,sockets=1,dies=1,cores=2,threads=1 -m 2G -name Virtual-DSM,process=virtual-dsm -pidfile /run/shm/qemu.pid -display none -serial mon:stdio -netdev user,id=net0 -device virtio-net-pci,netdev=net0,bus=pcie.0,addr=0x12 -drive file=/storage/dsm.boot.img,id=synoboot -drive file=/storage/dsm.system.img,id=synosys -boot strict=on -object rng-random,id=objrng0,filename=/dev/urandom -device virtio-rng-pci,rng=objrng0,id=rng0,bus=pcie.0,addr=0x1c -device virtio-balloon-pci,id=balloon0,bus=pcie.0,addr=0x4
