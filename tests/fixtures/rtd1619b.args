-machine
virt,gic-version=3
-accel
tcg,thread=multi
-cpu
max,lpa2=off
-smp
2
-m
2G
-name
Virtual-DSM,process=virtual-dsm
-pidfile
/run/shm/qemu.pid
-nic
none
-kernel
/storage/DSM_DS124_72806.kernel
-initrd
/storage/DSM_DS124_72806.initrd
-append
earlycon=uart8250,mmio32,0x0b000000 console=ttyS0,115200 initcall_debug keep_bootcon ignore_loglevel loglevel=8 printk.time=1 rdinit=/init pty.legacy_count=0 root=/dev/sata1p1 libata.force=noncq vdsm.host_epoch=1704067200
-nographic
-monitor
none
-serial
null
-serial
stdio
-serial
null
-no-reboot
-qmp
unix:/run/shm/arm-qmp.sock,server=on,wait=off
-drive
file=/storage/DSM_DS124_72806.system.img,format=raw,if=ide,index=0
-netdev
user,id=net0,hostfwd=tcp:0.0.0.0:5000-10.0.2.15:5000,hostfwd=tcp:0.0.0.0:5001-10.0.2.15:5001
-device
usb-net,netdev=net0,mac=00:16:3e:12:34:56
